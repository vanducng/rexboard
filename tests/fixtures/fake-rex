#!/bin/sh
# Stands in for the rex CLI and logs argv to $FAKE_REX_LOG.
#   do - --all   streams $FAKE_REX_OBSERVER_<host> or observer-<host>.ndjson (host from -S, else studio), then
#                $FAKE_REX_APPEND_<host> or $FAKE_REX_APPEND if set; FAKE_REX_EXIT_AFTER=N exits after N lines,
#                with status 1 and $FAKE_REX_STDERR on stderr when that is set
#   do -         prints a recorded snapshot, or for the jump script $FAKE_REX_JUMP_REPLY
#                (default {"ok":true})
#   hosts        lists one remote host, mini
#   capture      prints a few lines of generic pane text, or the file $FAKE_REX_CAPTURE names when set
#   new          succeeds, and touches $FAKE_REX_STATE/made when FAKE_REX_STATE is set
#   do - (window script, mode open) prints $FAKE_REX_OPEN_REPLY (default {"ok":true,"reply":{}});
#                mode destroy prints $FAKE_REX_DESTROY_REPLY, other modes $FAKE_REX_WINDOW_REPLY
#                (both default {"ok":true})
#                A destroy without session.attach first fails as Rex does (409, not attached).
#   FAKE_REX_ENV_LOG  each call appends the REX_BLOCK, REX_SESSION and REX_CLIENT it sees (- if unset)
#   do - (snapshot) with $FAKE_REX_FIXTURES set: the Nth call prints $FAKE_REX_FIXTURES/N.json, or
#                the last one there is; the count lives in $FAKE_REX_STATE
if [ -n "${FAKE_REX_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$FAKE_REX_LOG"
fi
if [ -n "${FAKE_REX_ENV_LOG:-}" ]; then
  printf 'REX_BLOCK=%s REX_SESSION=%s REX_CLIENT=%s\n' "${REX_BLOCK:--}" "${REX_SESSION:--}" "${REX_CLIENT:--}" >>"$FAKE_REX_ENV_LOG"
fi
dir=$(dirname "$0")
host=studio
if [ "${1:-}" = "-S" ]; then
  host=$2
  shift 2
fi
if [ "${1:-}" = new ]; then
  if [ -n "${FAKE_REX_STATE:-}" ]; then
    touch "$FAKE_REX_STATE/made"
  fi
  exit 0
fi
case " $* " in
  *" do - --all "*)
    cat >/dev/null
    observer=$dir/observer-$host.ndjson
    eval "observer=\${FAKE_REX_OBSERVER_$host:-\$observer}"
    if [ -n "${FAKE_REX_EXIT_AFTER:-}" ]; then
      head -n "$FAKE_REX_EXIT_AFTER" "$observer"
      if [ -n "${FAKE_REX_STDERR:-}" ]; then
        echo "$FAKE_REX_STDERR" >&2
        exit 1
      fi
      exit 0
    fi
    cat "$observer"
    eval "append=\${FAKE_REX_APPEND_$host:-\${FAKE_REX_APPEND:-}}"
    if [ -n "$append" ]; then
      echo "$append"
    fi
    # exec: a forked sleep can miss the group SIGTERM on macOS and hold the pipes open.
    exec sleep 30
    ;;
  *" do - "*)
    script=$(cat)
    case "$script" in
      *session.focus_block*) ok='{"ok":true}'; printf '%s\n' "${FAKE_REX_JUMP_REPLY:-$ok}" ;;
      *client.window.new*)
        case " $* " in
          *'"mode":"open"'*) ok='{"ok":true,"reply":{}}'; printf '%s\n' "${FAKE_REX_OPEN_REPLY:-$ok}" ;;
          *'"mode":"destroy"'*)
            if printf '%s\n' "$script" | sed -n '/a.mode == "destroy"/,/"session.destroy"/p' | grep -q '"session.attach"'; then
              ok='{"ok":true}'
            else
              ok='{"ok":false,"step":"session.destroy","error":"stream is not attached to session (status=409 code=conflict)"}'
            fi
            printf '%s\n' "${FAKE_REX_DESTROY_REPLY:-$ok}"
            ;;
          *) ok='{"ok":true}'; printf '%s\n' "${FAKE_REX_WINDOW_REPLY:-$ok}" ;;
        esac
        ;;
      *)
        if [ -n "${FAKE_REX_FIXTURES:-}" ]; then
          n=$(($(cat "$FAKE_REX_STATE/snapshot-count" 2>/dev/null || echo 0) + 1))
          echo "$n" >"$FAKE_REX_STATE/snapshot-count"
          while [ "$n" -gt 1 ] && [ ! -e "$FAKE_REX_FIXTURES/$n.json" ]; do n=$((n - 1)); done
          cat "$FAKE_REX_FIXTURES/$n.json"
        else
          cat "${FAKE_REX_FIXTURE:-$dir/snapshot-two-hosts.json}"
        fi
        ;;
    esac
    ;;
  *" capture "*)
    if [ -n "${FAKE_REX_CAPTURE:-}" ]; then
      cat "$FAKE_REX_CAPTURE"
      exit 0
    fi
    printf '%s\n' '$ cargo test' 'running 12 tests' 'test parser::empty ... ok' \
      'test parser::nested ... ok' 'test result: ok. 12 passed' '' 'Allow Bash: cargo test? (y/n)'
    ;;
  " hosts --json ")
    echo '{"hosts":[{"host":{"label":"mini"}}]}'
    ;;
  *)
    echo "fake-rex: unsupported: $*" >&2
    exit 64
    ;;
esac
